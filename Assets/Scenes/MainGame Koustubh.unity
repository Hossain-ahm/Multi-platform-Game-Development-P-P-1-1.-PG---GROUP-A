  - dialog: Welcome to Velkele, Trivian
    character: 0
    tone: 0
    action:
      m_PersistentCalls:
        m_Calls: []
  - dialog: Press space to flap your wings.
    character: 2
    tone: 0
    action:
      m_PersistentCalls:
        m_Calls: []
  - dialog: This is your stamina, it will regenerate over time.
    character: 2
    tone: 0
    action:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 651013565}
